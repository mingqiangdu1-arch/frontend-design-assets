{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    "packages/ui/src/**/*",
    "playground/component-gallery/src/**/*",
    "playground/precision-workbench/src/**/*.tsx",
    "playground/precision-workbench/src/**/*.ts",
    "playground/editorial-review/src/**/*.tsx",
    "playground/editorial-review/src/**/*.ts"
  ]
}
