{
  "name": "frontend-design-assets",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "license": "MIT",
  "description": "Living multi-style design assets, React component lab and independent research demos.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mingqiangdu1-arch/frontend-design-assets.git"
  },
  "homepage": "https://mingqiangdu1-arch.github.io/frontend-design-assets/",
  "bugs": {
    "url": "https://github.com/mingqiangdu1-arch/frontend-design-assets/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test:unit": "node --test tests/*.test.mjs",
    "test:tokens": "node scripts/contrast-audit.mjs",
    "test:registry": "node scripts/check-registry.mjs",
    "test:browser": "playwright test",
    "dev:components": "vite --config playground/component-gallery/vite.config.ts",
    "build:components": "vite build --config playground/component-gallery/vite.config.ts",
    "build:pages": "npm run build:ui && vite build --config playground/component-gallery/vite.config.ts --base=./ && node scripts/build-pages-site.mjs",
    "build:ui": "vite build --config packages/ui/vite.config.ts && tsc -p packages/ui/tsconfig.build.json",
    "typecheck:ui": "tsc -p tsconfig.json --noEmit",
    "test:components:browser": "playwright test -c playwright.components.config.mjs",
    "check:components": "npm run typecheck:ui && npm run build:ui && npm run build:components",
    "compose:page": "node scripts/compose-page.mjs",
    "check:page-blueprints": "node scripts/check-page-templates.mjs",
    "dev:workbench": "vite --config playground/precision-workbench/vite.config.ts",
    "build:workbench": "vite build --config playground/precision-workbench/vite.config.ts",
    "test:workbench:browser": "playwright test -c playwright.workbench.config.mjs",
    "dev:catalog": "node scripts/dev-static.mjs",
    "test:catalog": "node --test tests/asset-explorer.test.mjs",
    "test:commerce": "node --test tests/commerce-atelier.test.mjs",
    "dev:editorial-react": "vite --config playground/editorial-review/vite.config.ts",
    "build:editorial-react": "vite build --config playground/editorial-review/vite.config.ts",
    "test:editorial-react:browser": "playwright test -c playwright.editorial.config.mjs",
    "test:component-states": "node scripts/check-component-states.mjs",
    "visual:capture": "node scripts/visual-evidence.mjs capture",
    "visual:verify": "node scripts/visual-evidence.mjs verify",
    "screenshots:public": "node scripts/capture-public-screenshots.mjs",
    "creative:brief": "node scripts/creative-director.mjs",
    "design:plan": "node scripts/plan-design-review.mjs",
    "design:compose": "node scripts/plan-design-composition.mjs",
    "design:themes": "node scripts/select-style.mjs",
    "design:assemble": "node scripts/build-style-brief.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0"
  }
}
