{
  "name": "frontend-design-assets",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "Living multi-style design assets, React component lab and independent research demos.",
  "scripts": {
    "test:unit": "node --test tests/*.test.mjs",
    "test:tokens": "node scripts/contrast-audit.mjs",
    "test:registry": "node scripts/check-registry.mjs",
    "test:browser": "playwright test",
    "dev:components": "vite --config playground/component-gallery/vite.config.ts",
    "build:components": "vite build --config playground/component-gallery/vite.config.ts",
    "build:ui": "vite build --config packages/ui/vite.config.ts && tsc -p packages/ui/tsconfig.build.json",
    "typecheck:ui": "tsc -p tsconfig.json --noEmit",
    "test:components:browser": "playwright test -c playwright.components.config.mjs",
    "check:components": "npm run typecheck:ui && npm run build:ui && npm run build:components",
    "compose:page": "node scripts/compose-page.mjs",
    "check:page-blueprints": "node scripts/check-page-templates.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0"
  }
}
